{
  "name": "grist-widget-dbml",
  "version": "3.22.0",
  "description": "Widget Grist (DSFR) : structure du document en DBML",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/revues/*.test.mjs",
    "test:ui": "node tests/ui/run-ui.mjs",
    "test:erd": "node tests/ui/run-erd.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test:deployed": "node tests/ui/run-deployed.mjs",
    "format": "prettier --write \"assets/*.js\" assets/styles.css index.html \"tests/*.mjs\" \"tests/revues/*.mjs\" \"tests/ui/*.mjs\" \"scripts/*.mjs\"",
    "lint": "prettier --check \"assets/*.js\" assets/styles.css index.html \"tests/*.mjs\" \"tests/revues/*.mjs\" \"tests/ui/*.mjs\" \"scripts/*.mjs\"",
    "version": "node scripts/version.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "docx": "9.10.0",
    "jszip": "3.10.1",
    "prettier": "3.6.2"
  }
}
